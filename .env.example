# Frontend only. Put backend settings and GOOGLE_API_KEY in the Render service.
VITE_ROI_ENABLED=true
# Development API. In Netlify set this to https://YOUR-API.onrender.com,
# without a trailing slash or /api/roi/v1 suffix, then rebuild.
VITE_ROI_API_BASE_URL=http://127.0.0.1:8080
VITE_ROI_DETECTION_TIMEOUT_MS=930000
VITE_ENABLE_SEND_TO_TAPEREDPLUS=false
