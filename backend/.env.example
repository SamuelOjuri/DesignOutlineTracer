# Backend service
APP_NAME=Design Outline Tracer Backend
APP_ENV=local
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_ROOT=storage
AI_PROVIDER=mock
GEMINI_VALIDATION_MODEL=gemini-3-flash-preview
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Loaded from ../.env when present; backend/.env can override locally.
GOOGLE_API_KEY=
OPENAI_API_KEY=
MISTRALAI_API_KEY=

# Phase 7 raster fallback defaults.
RASTER_PREVIEW_DPI=125
RASTER_RENDER_DPI=300
RASTER_MAX_RENDER_PIXELS=80000000
RASTER_MAX_TILE_PIXELS=5000000
RASTER_OCR_PROVIDER=mock
GEMINI_OCR_MODEL=gemini-3-flash-preview
OCR_CACHE_DIR=cache/ocr
OCR_TILE_SIZE_PX=2048
OCR_TILE_OVERLAP_PX=256
OCR_MAX_TILES=12
ALLOW_LIVE_AI_CALLS=0
ALLOW_GEMINI_PRO_ESCALATION=0
GEMINI_PRO_ESCALATION_CONFIDENCE_THRESHOLD=0.75
SEGMENTATION_PROVIDER=noop
GEMINI_ER_MODEL=gemini-robotics-er-2-preview
GEMINI_ER_MAX_IMAGE_DIMENSION=2048
GEMINI_ER_CACHE_DIR=cache/gemini_er
FALCON_PERCEPTION_BASE_URL=
FALCON_PERCEPTION_TIMEOUT_SECONDS=60
FALCON_PERCEPTION_MAX_IMAGE_DIMENSION=1024
FALCON_PERCEPTION_MIN_IMAGE_DIMENSION=256
FALCON_PERCEPTION_MAX_PROMPTS=4
FALCON_PERCEPTION_CACHE_DIR=storage/cache/segmentation
