# Backend service
APP_NAME=Design Outline Tracer Backend
APP_ENV=local
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_ROOT=storage
AI_PROVIDER=mock
GEMINI_VALIDATION_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Loaded from ../.env when present; backend/.env can override locally.
GOOGLE_API_KEY=
OPENAI_API_KEY=
MISTRALAI_API_KEY=

# Phase 7 raster fallback defaults, documented now for the planned contract.
RASTER_OCR_PROVIDER=gemini
GEMINI_OCR_MODEL=gemini-2.5-flash
RASTER_RENDER_DPI=400
OCR_CACHE_DIR=storage/cache/ocr
OCR_MAX_TILES=12
