ROI_MODEL=gemini-4-argon
ROI_THINKING_LEVEL=medium
ROI_MAX_OUTPUT_TOKENS=32768
# Applied to gemini-3.7-flash only; omitted for Argon.
ROI_TEMPERATURE=0.5
ROI_ALLOW_LIVE=true
GOOGLE_API_KEY=
ROI_STRUCTURED_OUTPUT=false
# JSON mode without a schema; set false to restore free-form replies.
ROI_JSON_MODE=true
# Shapely repair/clip/thin-feature clean-up of model outlines before fitting; "none" disables it.
ROI_OUTLINE_CLEANUP=shapely
ROI_DEPLOYMENT_MODE=localhost_only
ROI_STORAGE_BACKEND=auto
ROI_ALLOWED_ORIGINS="http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:8083,http://127.0.0.1:8084"
# Supabase state: set these in the backend environment after applying the
# checked-in migration and creating a private roi-pages Storage bucket.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SECRET_KEY=YOUR-BACKEND-SECRET-KEY
# DATABASE_URL=postgresql://YOUR-USER:YOUR-PASSWORD@YOUR-SESSION-POOLER:5432/postgres?sslmode=require
# ROI_STORAGE_BUCKET=roi-pages
# Public Render deployment (the Blueprint selects Supabase storage):
# ROI_DEPLOYMENT_MODE=public
# ROI_ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app,https://YOUR-CUSTOM-DOMAIN
# SQLite remains available as an explicit fallback with a persistent disk:
# ROI_STORAGE_BACKEND=sqlite
# ROI_STATE_PATH=/var/data/roi.sqlite3
# Render's own hostname is accepted automatically. If you use a custom API
# domain, list it and the Render hostname explicitly (hostnames, without scheme):
# ROI_ALLOWED_HOSTS=YOUR-API.onrender.com,api.example.com
ROI_MAX_ATTEMPTS=2
ROI_MAX_CALLS_PER_SESSION=12
ROI_MAX_TOTAL_CALLS=100
# Global provider calls are counted in this rolling window, including across restarts.
ROI_CALL_BUDGET_WINDOW_SECONDS=86400
ROI_TIMEOUT_SECONDS=900
ROI_PAGE_TTL_SECONDS=1800
ROI_CACHE_TTL_SECONDS=300
